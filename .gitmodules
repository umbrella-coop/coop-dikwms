[submodule "third-party/terminusdb-client-rs"]
	path = third-party/terminusdb-client-rs
	# Renamed 2026-08-11: third_party/terminusdb-rs → third-party/terminusdb-client-rs
	# (fork repo also renamed gustavorps/terminusdb-rs → terminusdb-client-rs).
